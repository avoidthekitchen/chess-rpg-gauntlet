{
  "name": "pawnshire",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm run build && vitest run",
    "ci": "node scripts/ci/run.mjs",
    "stage": "node scripts/stage-deploy.mjs",
    "deploy": "npm run build && node scripts/stage-deploy.mjs && wrangler deploy",
    "build:staging": "tsc --noEmit && vite build --mode staging --outDir dist-staging",
    "deploy:staging": "npm run build:staging && node scripts/stage-deploy.mjs --staging && wrangler deploy --env staging"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.3.0",
    "chess.js": "^1.4.0",
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.97.0"
  }
}
