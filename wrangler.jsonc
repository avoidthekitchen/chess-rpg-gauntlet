{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static assets only (no Worker script), so it stays in the free tier.
  "name": "chess-rpg",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // Zone routes, like the site's other prototypes. They only match /chess-rpg*, so the
  // site's own unformedideas.com/* Worker keeps everything else.
  "routes": [
    { "pattern": "unformedideas.com/chess-rpg*", "zone_name": "unformedideas.com" },
    { "pattern": "www.unformedideas.com/chess-rpg*", "zone_name": "unformedideas.com" }
  ],
  // `npm run deploy` stages the build at dist-worker/chess-rpg/ so files mirror the route path.
  // /chess-rpg redirects to /chess-rpg/ (auto-trailing-slash), which the relative asset paths need.
  "assets": {
    "directory": "./dist-worker",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
